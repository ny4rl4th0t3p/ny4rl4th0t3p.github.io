---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { areas } from '../data/projects';
---

<Base
  title="ny4rl4th0t3p"
  description="Self-hostable backend software, and findings anyone can reproduce."
>
  <Header />

  <main>
    <section class="hero">
      <h1>Software you host yourself, and evidence you can rerun.</h1>
      <p class="lede">
        I build small, focused backend tools: game servers a small team can run on one machine, and instruments that
        check what networks and registries declare against what is actually live. Everything is Apache 2.0 and
        self-hostable, and every finding comes with a reproduction, filed where it belongs.
      </p>
    </section>

    <div id="work">
      {
        areas.map((area) => (
          <section class="area" id={area.id} aria-labelledby={`${area.id}-title`}>
            <div class="area-head">
              <h2 id={`${area.id}-title`}>{area.title}</h2>
              <p>{area.summary}</p>
            </div>
            <div class="area-body">
              {area.projects.map((project) => (
                <Entry project={project} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>

  <Footer />
</Base>