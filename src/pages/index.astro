---
import Base from '../layouts/Base.astro';
import Entry from '../components/Entry.astro';
import { areas, findingsUrl } from '../data/projects';
import { linkAttrs } from '../lib/links';
import ThemeToggle from '../components/ThemeToggle.astro';

const github = 'https://github.com/ny4rl4th0t3p';
---

<Base
  title="ny4rl4th0t3p"
  description="Self-hostable backend software, and findings anyone can reproduce."
>
  <header class="top">
    <a class="handle" href="/">ny4rl4th0t3p</a>
    <nav aria-label="Site">
      <a href="#work">Work</a>
      <a href={findingsUrl}>Findings</a>
      <a href={github} {...linkAttrs(github)}>GitHub</a>
      <ThemeToggle />
    </nav>
  </header>

  <main>
    <section class="hero">
      <h1>Software you host yourself, and evidence you can rerun.</h1>
      <p class="lede">
        I build small, focused backend tools: game servers a small team can run on one machine, and instruments that
        check what networks and registries declare against what is actually live. Everything is Apache 2.0 and
        self-hostable, and every finding comes with a reproduction, filed where it belongs.
      </p>
    </section>

    <div id="work">
      {
        areas.map((area) => (
          <section class="area" id={area.id} aria-labelledby={`${area.id}-title`}>
            <div class="area-head">
              <h2 id={`${area.id}-title`}>{area.title}</h2>
              <p>{area.summary}</p>
            </div>
            <div class="area-body">
              {area.projects.map((project) => (
                <Entry project={project} />
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>

  <footer class="bottom">
    <p>
      For questions, bug reports, collaboration or work, open an issue or a discussion on the project's repository.
    </p>
  </footer>
</Base>